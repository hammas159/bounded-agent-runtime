# Backend: ollama (local, free) | anthropic | huggingface
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
HF_TOKEN=

# Ceilings. Tight on purpose - a runtime whose defaults are generous is not bounded.
MAX_STEPS=20
MAX_SECONDS=120
MAX_USD=0.25
MAX_TOOL_CALLS=40
MAX_REPEATS=3

AUDIT_DIR=runs
